{
  "title": "Reusable flame parameter comparison",
  "output_directory": "outputs/example",
  "write_transposed_matrix": true,
  "enforce_expected_counts": false,
  "histogram": {
    "minimum_bins": 8,
    "maximum_bins": 40
  },
  "comparison": {
    "minimum_reference_observations": 100,
    "minimum_target_observations": 30
  },
  "groups": [
    {
      "name": "reference",
      "folders": [
        "D:/path/to/reference/folder"
      ],
      "recursive": false,
      "include_run_ids": []
    },
    {
      "name": "selected",
      "folders": [
        "D:/path/to/selected/folder"
      ],
      "recursive": false,
      "include_source_id_regex": ""
    },
    {
      "name": "images_only_inventory",
      "folders": [
        "D:/path/to/images"
      ],
      "analyze": false
    }
  ],
  "reference_group": "reference",
  "comparison_groups": [
    "selected"
  ],
  "expected_generator": {
    "minimum_transform_count": 2,
    "maximum_transform_count": 5,
    "symmetry_types": [
      "rotational"
    ],
    "symmetry_chance": 0.4,
    "symmetry_orders": [
      2,
      3
    ],
    "minimum_affine_rotation_degrees": -180.0,
    "maximum_affine_rotation_degrees": 180.0,
    "minimum_affine_scale": 0.35,
    "maximum_affine_scale": 0.85,
    "minimum_affine_shear": -0.25,
    "maximum_affine_shear": 0.25,
    "translation_extent": 0.75,
    "transform_selection_balance": 0.35,
    "minimum_variation_count": 1,
    "maximum_variation_count": 3,
    "enabled_variations": [
      "linear",
      "sinusoidal"
    ],
    "variation_blend_dominance": 0.5,
    "post_transform_chance": 0.42,
    "minimum_post_rotation_degrees": -180.0,
    "maximum_post_rotation_degrees": 180.0,
    "minimum_post_scale": 0.75,
    "maximum_post_scale": 1.25,
    "post_translation_extent": 0.18,
    "allow_final_transforms": false,
    "final_transform_chance": 0.15
  }
}
