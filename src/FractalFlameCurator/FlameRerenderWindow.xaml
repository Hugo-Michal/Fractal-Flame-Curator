<Window x:Class="FractalFlameCurator.FlameRerenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalFlameCurator.Controls"
        Title="Flame Re-render Tool" Width="1200" Height="820" MinWidth="800" MinHeight="560"
        Background="#0D1218" Foreground="#F3F6FA">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Load a .flame, then use Re-render to sample the flame or apply image adjustments. The source file is left unchanged." TextWrapping="Wrap" Margin="0,0,0,8" />
    <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,8">
      <Button x:Name="LoadButton" DockPanel.Dock="Left" Content="Load .flame…" Click="Load_Click" Margin="0,0,8,0" />
      <TextBox x:Name="FlamePathTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="SettingsPanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="Step 1 — Flame sampling" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
          <TextBlock Text="Changes here require sampling the flame again." TextWrapping="Wrap" Foreground="#A7B3C1" />
          <TextBlock Text="Camera" FontWeight="SemiBold" Margin="0,8,0,0" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,4,0"><Label Content="Center X" Target="{Binding ElementName=CenterXTextBox}" /><TextBox x:Name="CenterXTextBox" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="Center Y" Target="{Binding ElementName=CenterYTextBox}" /><TextBox x:Name="CenterYTextBox" /></StackPanel>
            <StackPanel Margin="0,0,4,0"><Label Content="Scale" Target="{Binding ElementName=ScaleTextBox}" /><TextBox x:Name="ScaleTextBox" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="Rotation (degrees)" Target="{Binding ElementName=RotationTextBox}" /><TextBox x:Name="RotationTextBox" /></StackPanel>
          </UniformGrid>
          <TextBlock Text="Sampling settings" FontWeight="SemiBold" Margin="0,10,0,0" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,4,0"><Label Content="Output size (square)" Target="{Binding ElementName=SizeTextBox}" /><TextBox x:Name="SizeTextBox" ToolTip="Pixels per side, 32–10 000" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="CPU workers" Target="{Binding ElementName=WorkersTextBox}" /><TextBox x:Name="WorkersTextBox" ToolTip="Parallel CPU sampling workers" /></StackPanel>
            <StackPanel Margin="0,0,4,0"><Label Content="Sample budget (points)" Target="{Binding ElementName=SamplesTextBox}" /><TextBox x:Name="SamplesTextBox" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="Oversample" Target="{Binding ElementName=OversampleComboBox}" /><ComboBox x:Name="OversampleComboBox"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /></ComboBox></StackPanel>
            <StackPanel Margin="0,0,4,0"><Label Content="Palette" Target="{Binding ElementName=PaletteComboBox}" /><ComboBox x:Name="PaletteComboBox" /></StackPanel>
          </UniformGrid>
          <TextBlock Text="Step 2 — Image adjustments" FontWeight="Bold" FontSize="15" Margin="0,14,0,4" />
          <TextBlock Text="After sampling, press Re-render to apply these changes without new points." TextWrapping="Wrap" Foreground="#A7B3C1" />
          <TextBlock Text="Master RGB curve · histogram before curve" FontWeight="SemiBold" Margin="0,8,0,0" />
          <controls:ToneCurveEditor x:Name="CurveEditor" Height="210" Margin="0,3,0,0"
                                    ToolTip="Drag the bottom black/white markers to set input levels. Click to add a point; drag to move it; right-click to remove it." />
          <TextBlock Text="Drag bottom markers for black and white inputs. Click to add curve points; drag to move; right-click to remove. Histogram height uses a logarithmic scale." Foreground="#A7B3C1" TextWrapping="Wrap" Margin="0,3,0,0" />
          <Button Content="Reset curve" Click="ResetCurve_Click" HorizontalAlignment="Left" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,4,0"><Label Content="Filter radius" Target="{Binding ElementName=FilterTextBox}" /><TextBox x:Name="FilterTextBox" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="Smoothing (pixels)" Target="{Binding ElementName=SmoothingTextBox}" /><TextBox x:Name="SmoothingTextBox" ToolTip="Gaussian smoothing after rendering; larger values soften details" /></StackPanel>
            <StackPanel Margin="0,0,4,0"><Label Content="Vibrancy" Target="{Binding ElementName=VibrancyTextBox}" /><TextBox x:Name="VibrancyTextBox" /></StackPanel>
            <StackPanel Margin="4,0,0,0"><Label Content="Low-density cutoff" Target="{Binding ElementName=CutoffTextBox}" /><TextBox x:Name="CutoffTextBox" /></StackPanel>
          </UniformGrid>
          <CheckBox x:Name="StableToneCheckBox" Content="Keep tone stable as point count changes" Margin="0,10,0,0" ToolTip="Normalize density to a 20-million-point reference; other settings can still change the image." />
          <TextBlock Text="More oversampling uses much more memory and may require more points. Smoothing reduces grain but softens detail." TextWrapping="Wrap" Foreground="#A7B3C1" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Background="#090D12" BorderBrush="#27313D" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        PreviewMouseWheel="PreviewScroll_MouseWheel" SizeChanged="PreviewScroll_SizeChanged">
            <Grid x:Name="PreviewHost" ClipToBounds="True">
              <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock x:Name="EmptyPreviewText" Text="Choose a .flame file to begin" Foreground="#A7B3C1" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,3">
            <Button Content="Zoom to fit" Click="ZoomFit_Click" />
            <Button Content="Actual size" Click="ActualSize_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="RenderButton" Content="Re-render" Click="Render_Click" IsEnabled="False" />
        <Button x:Name="SaveButton" Content="Save 16-bit PNG As…" Click="Save_Click" IsEnabled="False" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
        <TextBlock x:Name="RenderModeText" Text="Load a flame to begin." Foreground="#A7B3C1" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
