<Window x:Class="FractalFlameCurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Fractal-Flame Curator"
        Width="1540" Height="920" MinWidth="1180" MinHeight="700"
        Background="#0D1218" Foreground="#F3F6FA"
        Icon="Assets/AppIcon.ico"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="430" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="FRACTAL-FLAME CURATOR" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2" />
          <TextBlock Text="Phase 2 · optional learned preference ranking" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />

          <Expander Header="Rendering" IsExpanded="True" Margin="0,0,0,6">
            <StackPanel>
              <Label Content="Output directory" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="0" TextChanged="OutputDirectoryTextBox_TextChanged" />
                <Button Grid.Column="1" Content="…" Click="BrowseOutput_Click" ToolTip="Choose output directory" />
              </Grid>
              <Label Content="Base random seed" />
              <TextBox x:Name="SeedTextBox" />
              <Button x:Name="RandomGeneratorSettingsButton"
                      Content="Random generator settings…"
                      Click="RandomGeneratorSettings_Click"
                      HorizontalAlignment="Left"
                      Margin="2,7,2,3"
                      ToolTip="Configure the ranges used to create random fractal flames"
                      AutomationProperties.HelpText="Open the random fractal generator settings window" />
              <CheckBox x:Name="CopyRatedFilesCheckBox"
                        Content="Copy rated pairs to scoring folders (keep rendered originals)"
                        Margin="2,2,2,3"
                        ToolTip="When enabled, rating copies the image and .flame pair. Rated source IDs remain hidden from new candidates. When disabled, rating moves the pair." />
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="Session limit" Target="{Binding ElementName=BatchLimitTextBox}" /><TextBox x:Name="BatchLimitTextBox" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Workers" Target="{Binding ElementName=WorkersTextBox}" /><TextBox x:Name="WorkersTextBox" /></StackPanel>
                <StackPanel Grid.Column="4"><Label Content="Bounded render queue" Target="{Binding ElementName=QueueCapacityTextBox}" /><TextBox x:Name="QueueCapacityTextBox" /></StackPanel>
              </Grid>
              <WrapPanel Margin="-2,5,0,6">
                <Button x:Name="StartStopRenderButton" Content="Start" Click="Start_Click" IsDefault="True" ToolTip="Start rendering, or stop the active render session" />
                <Button x:Name="PauseResumeRenderButton" Content="Pause" Click="Pause_Click" ToolTip="Pause rendering, or resume the paused render session" />
              </WrapPanel>
              <TextBlock Text="Built-in renderer: bounded managed CPU · 2048×2048 default" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="QueueTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock x:Name="SessionTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Expander Header="Image" IsExpanded="False" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="These settings affect the current viewport only after you re-render. The source .flame file is preserved." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="Sample budget (points)" Target="{Binding ElementName=SampleBudgetTextBox}" /><TextBox x:Name="SampleBudgetTextBox" ToolTip="Number of points used for the render" AutomationProperties.HelpText="Number of points used for the render" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Oversample" Target="{Binding ElementName=OversampleComboBox}" /><ComboBox x:Name="OversampleComboBox" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" ToolTip="Internal render multiplier before downsampling"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /></ComboBox></StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="Filter radius" Target="{Binding ElementName=FilterRadiusTextBox}" /><TextBox x:Name="FilterRadiusTextBox" ToolTip="Downsampling filter radius" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Gamma" Target="{Binding ElementName=GammaTextBox}" /><TextBox x:Name="GammaTextBox" ToolTip="Tone response; lower values increase separation in this renderer" /></StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="Brightness" Target="{Binding ElementName=BrightnessTextBox}" /><TextBox x:Name="BrightnessTextBox" ToolTip="Exposure applied before tone mapping" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Vibrancy" Target="{Binding ElementName=VibrancyTextBox}" /><TextBox x:Name="VibrancyTextBox" ToolTip="Color saturation for non-monochrome palettes" /></StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="White point (0–1)" Target="{Binding ElementName=WhitePointTextBox}" /><TextBox x:Name="WhitePointTextBox" ToolTip="Normalized density at or below which pixels are white" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Black point (0–1)" Target="{Binding ElementName=BlackPointTextBox}" /><TextBox x:Name="BlackPointTextBox" ToolTip="Normalized density at or above which pixels are black" /></StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><Label Content="Contrast curve" Target="{Binding ElementName=ContrastCurveTextBox}" /><TextBox x:Name="ContrastCurveTextBox" ToolTip="1 is neutral; values above 1 increase midtone separation" /></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Low-density cutoff" Target="{Binding ElementName=LowDensityCutoffTextBox}" /><TextBox x:Name="LowDensityCutoffTextBox" ToolTip="Normalized density below which the pixel becomes white" /></StackPanel>
              </Grid>
              <Grid Margin="0,1,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Label Content="Palette" Target="{Binding ElementName=PaletteComboBox}" />
                  <ComboBox x:Name="PaletteComboBox" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" ToolTip="Palette used for the next render">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="Monochrome is the explicit default. Additional palettes are opt-in." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
              <WrapPanel Margin="-2,5,0,0">
                <Button x:Name="RerenderCurrentButton" Content="Re-render current flame" Click="RerenderCurrent_Click" ToolTip="Render the selected source flame, or cancel while it is running" />
                <Button x:Name="RerenderRatedButton" Content="Re-render rated flames" Click="RerenderRated_Click" ToolTip="Replace all rated PNGs using the current image settings" />
              </WrapPanel>
              <TextBlock x:Name="ImageSettingsStatusTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </Expander>

          <Expander Header="AI Scoring" IsExpanded="True" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="DINOv2 ViT-B/14 · frozen backbone · four-threshold ordinal head" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
              <WrapPanel Margin="-2,7,0,5">
                <Button Content="Start AI scoring" Click="StartAi_Click" />
                <Button Content="Stop AI scoring" Click="StopAi_Click" />
                <Button Content="Train Model" Click="TrainModel_Click" />
                <Button x:Name="RescoreRatedDatasetButton" Content="Rescore rated" Click="RescoreRatedDataset_Click" ToolTip="Score all PNG, JPG, and JPEG images in ratings/1–5 and update their score prefixes without changing rating folders" />
              </WrapPanel>
              <TextBlock x:Name="TrainingDatasetPathTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,2,4" ToolTip="The Train Model button reads rated images from this directory." />
              <TextBlock x:Name="TrainingWarningTextBlock" Foreground="#F4B860" TextWrapping="Wrap" />
              <TextBlock x:Name="AiStatusTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="TrainingMetricsTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Expander Header="Dataset Statistics" IsExpanded="False" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="Human ratings only; AI never edits these folders." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="1" Foreground="#F06A6A" />
                <Border Grid.Column="1" Background="#3C2429" Height="14" HorizontalAlignment="Left"><Border x:Name="RatingBar1" Background="#D9535F" Height="14" HorizontalAlignment="Left" /></Border>
                <TextBlock x:Name="RatingCount1" Grid.Column="2" Text="0" HorizontalAlignment="Right" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="2" Foreground="#F4B860" />
                <Border Grid.Column="1" Background="#493A25" Height="14" HorizontalAlignment="Left"><Border x:Name="RatingBar2" Background="#E3A43B" Height="14" HorizontalAlignment="Left" /></Border>
                <TextBlock x:Name="RatingCount2" Grid.Column="2" Text="0" HorizontalAlignment="Right" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="3" Foreground="#B9C276" />
                <Border Grid.Column="1" Background="#3D4228" Height="14" HorizontalAlignment="Left"><Border x:Name="RatingBar3" Background="#AEBE4A" Height="14" HorizontalAlignment="Left" /></Border>
                <TextBlock x:Name="RatingCount3" Grid.Column="2" Text="0" HorizontalAlignment="Right" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="4" Foreground="#79CF94" />
                <Border Grid.Column="1" Background="#284634" Height="14" HorizontalAlignment="Left"><Border x:Name="RatingBar4" Background="#55B879" Height="14" HorizontalAlignment="Left" /></Border>
                <TextBlock x:Name="RatingCount4" Grid.Column="2" Text="0" HorizontalAlignment="Right" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="5" Foreground="#70E0AC" />
                <Border Grid.Column="1" Background="#25533E" Height="14" HorizontalAlignment="Left"><Border x:Name="RatingBar5" Background="#35C786" Height="14" HorizontalAlignment="Left" /></Border>
                <TextBlock x:Name="RatingCount5" Grid.Column="2" Text="0" HorizontalAlignment="Right" />
              </Grid>
              <TextBlock x:Name="DatasetReadinessTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
          </Expander>

          <Expander Header="Diagnostics" IsExpanded="False">
            <StackPanel>
              <TextBlock x:Name="BackendTextBlock" TextWrapping="Wrap" />
              <TextBlock x:Name="AiDiagnosticsTextBlock" TextWrapping="Wrap" />
              <TextBlock x:Name="RatingCountTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="Keyboard: 1–5 rate · ←/→ previous/next · P pause rendering · U undo · Esc stop rendering" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="2" Background="#080B10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#020304" BorderBrush="#26313D" BorderThickness="1">
          <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewMouseWheel="PreviewScroll_MouseWheel" SizeChanged="PreviewScroll_SizeChanged">
            <Grid x:Name="PreviewHost">
              <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock x:Name="EmptyPreviewTextBlock" Text="Start rendering or open the output directory to browse candidates" Foreground="#718398" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock x:Name="CurrentTextBlock" Grid.Row="0" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="1 ★" Tag="1" Click="Rating_Click" FontSize="18" MinWidth="82" ToolTip="Rate 1 star (1)" />
            <Button Content="2 ★" Tag="2" Click="Rating_Click" FontSize="18" MinWidth="82" ToolTip="Rate 2 stars (2)" />
            <Button Content="3 ★" Tag="3" Click="Rating_Click" FontSize="18" MinWidth="82" ToolTip="Rate 3 stars (3)" />
            <Button Content="4 ★" Tag="4" Click="Rating_Click" FontSize="18" MinWidth="82" ToolTip="Rate 4 stars (4)" />
            <Button Content="5 ★" Tag="5" Click="Rating_Click" FontSize="18" MinWidth="82" ToolTip="Rate 5 stars (5)" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
            <Button Content="Previous (←)" Click="Previous_Click" MinWidth="100" ToolTip="Show the previous candidate (Left Arrow)" />
            <Button Content="Next (→)" Click="Next_Click" MinWidth="100" ToolTip="Show the next unseen candidate (Right Arrow)" />
            <Button Content="Undo (U)" Click="Undo_Click" MinWidth="100" />
            <Button Content="Zoom to fit" Click="ZoomFit_Click" />
            <Button Content="Actual size" Click="ActualSize_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
